{
  "expo": {
    "name": "MAGUISSI BIRR",
    "slug": "maguissi-birr",
    "scheme": "maguissibir",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sn.maguissi.birr"
    },
    "android": {
      "package": "sn.maguissi.birr",
      "allowBackup": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez MAGUISSI BIRR à joindre une photo à un signalement.",
          "cameraPermission": "Autorisez MAGUISSI BIRR à photographier une situation à signaler."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/app-icon.png"
  }
}
