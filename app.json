{
  "expo": {
    "name": "MAGUISSI BIRR",
    "slug": "maguissi-birr",
    "scheme": "maguissibirr",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "sn.maguissibirr.mobile" },
    "android": { "package": "sn.maguissibirr.mobile", "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "CAMERA"] },
    "plugins": ["expo-router", "expo-location", ["expo-image-picker", { "photosPermission": "Autorisez MAGUISSI BIRR à joindre une photo à un signalement.", "cameraPermission": "Autorisez MAGUISSI BIRR à photographier une situation à signaler." }]],
    "experiments": { "typedRoutes": true }
  }
}
